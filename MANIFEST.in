# Source distribution: the package, its tests and the files the tests and the documentation need.
include CHANGELOG.md CITATION.cff CODE_OF_CONDUCT.md CONTRIBUTING.md LICENSE SECURITY.md README.md .zenodo.json mkdocs.yml
recursive-include tests *.py *.json
recursive-include examples *.py *.yaml *.toml
recursive-include tools *.py
graft docs
prune docs/fa
global-exclude *.py[cod] __pycache__
